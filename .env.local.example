# ──────────────────────────────────────────────────────────────────────
# Supabase
# ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────────────────────────────
# LinkedIn
# ──────────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/oauth/callback

# ──────────────────────────────────────────────────────────────────────
# Threads (Meta Developer Portal)
# Create app at https://developers.facebook.com/apps
#   - Add product: Threads API
#   - Scopes: threads_basic, threads_content_publish
#   - OAuth redirect: http://localhost:3000/api/threads/oauth/callback
# ──────────────────────────────────────────────────────────────────────
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/api/threads/oauth/callback

# ──────────────────────────────────────────────────────────────────────
# Instagram (Facebook Graph API)
# Same Meta Developer Portal as Threads (can use a single app or separate)
#   - Add product: Instagram Graph API + Facebook Login
#   - Scopes: instagram_basic, instagram_content_publish, pages_show_list,
#             pages_read_engagement, business_management
#   - OAuth redirect: http://localhost:3000/api/instagram/oauth/callback
# Note: User's Instagram account must be Business/Creator + linked to a FB Page
# ──────────────────────────────────────────────────────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/oauth/callback

# ──────────────────────────────────────────────────────────────────────
# Reddit (https://www.reddit.com/prefs/apps — "web app" 타입으로 생성)
#   - redirect uri: http://localhost:3000/api/reddit/oauth/callback
#   - OAuth2 duration=permanent, scopes: identity submit read flair
#   - 모든 API 요청에 고유 User-Agent 필수 (실서비스 도메인으로 교체 권장)
# ──────────────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:3000/api/reddit/oauth/callback
# Reddit 요구 User-Agent (비우면 기본값 web:postone:0.1.0 사용) — 실서비스는 앱 이름:버전 (by /u/계정)
REDDIT_USER_AGENT=

# ──────────────────────────────────────────────────────────────────────
# AI 채널별 변환 (2단계)
#   - ANTHROPIC_API_KEY가 있으면 Claude, 없으면 OPENAI_API_KEY로 폴백
#   - 둘 다 없으면 /api/ai/adapt가 503(AI_NOT_CONFIGURED) 응답
#   - 모델은 선택: 비우면 기본값(Claude=claude-sonnet-4-5 · OpenAI=gpt-4o-mini)
# ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ──────────────────────────────────────────────────────────────────────
# Cron (예약 발행 · 토큰 갱신)
#   - /api/cron/publish, /api/cron/refresh-tokens 의 Authorization 헤더 값
#   - generate with:
#       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   - Supabase pg_cron 설정 시 같은 값을 Bearer 토큰으로 넣는다
#   - 비우면 cron 엔드포인트는 503 으로 거부한다
# ──────────────────────────────────────────────────────────────────────
CRON_SECRET=

# ──────────────────────────────────────────────────────────────────────
# Crypto (32 bytes hex = 64 chars) — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ──────────────────────────────────────────────────────────────────────
TOKEN_ENCRYPTION_KEY=

# ──────────────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
